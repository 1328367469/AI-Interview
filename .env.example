# MySQL Database Configuration
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=3306

# DeepSeek API Configuration
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# SiliconFlow API Configuration (硅基流动 - DeepSeek V3)
# 硅基流动平台的 API 金钥 (如: sk-zkjdo...)。用于调用大语言模型。
SILICONFLOW_API_KEY=

# 硅基流动的 API 基础 URL (默认为 https://api.siliconflow.cn/v1)
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1

# 阿里云长语音识别与语音合成 (DashScope / CosyVoice / SenseVoice)
# 从阿里云控制台获取的 AccessKey ID。用于进行API调用的身份验证。
ALIYUN_AK_ID=

# 阿里云的 AccessKey Secret。用于API调用鉴权，请妥善保管。
ALIYUN_AK_SECRET=

# 阿里云的专属 AppKey (部分语音服务如智能语音交互需要)。在项目设置或服务详情中获取。
ALIYUN_APPKEY=

# 火山引擎 (字节跳动) 语音识别与合成 (豆包音色)
# 火山引擎的 Access Key (AK)。可在火山引擎控制台右上角API密钥管理中获取。
VOLCENGINE_AK=

# 火山引擎的 Secret Key (SK)。用于签发API请求的凭证。
VOLCENGINE_SK=
